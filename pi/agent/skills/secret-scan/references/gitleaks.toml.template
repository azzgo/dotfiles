# .gitleaks.toml — project secret-scan config
#
# Scaffolded by the `secret-scan` skill.
#
# Rules for editing this file:
#   - every allowlist entry gets a one-line reason above it
#   - every rule gets a line in the calibration fixture that fires it
#   - replace a leaked value with an obvious placeholder; allowlist only what cannot change
#
# Verify after editing:
#   gitleaks dir . --config .gitleaks.toml --no-banner     # working tree
#   gitleaks git . --config .gitleaks.toml --no-banner     # full history

title = "{{PROJECT_NAME}} secret scan"

[extend]
# Keep. Covers credentials; the rules below are additive, not a replacement.
useDefault = true

# ---------------------------------------------------------------------------
# Rules for this project's identifier shapes. Delete what does not apply, add what does.
# ---------------------------------------------------------------------------

# <!-- GENERATED RULES START -->
[[rules]]
id = "local-ip"
description = "Private IPv4 address committed as content"
regex = '''\b(?:192\.168|10\.\d{1,3}|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}'''
keywords = ["192.168", "10.", "172."]
tags = ["infrastructure", "identifier"]

[[rules]]
id = "public-ip"
description = "Public IPv4 address committed as content"
regex = '''\b(?:[1-9]\d{1,2}|[1-9])\.[1-9]\d{0,2}\.[1-9]\d{0,2}\.[1-9]\d{0,2}\b'''
keywords = ["."]
tags = ["infrastructure", "identifier"]

[[rules.allowlists]]
description = "documentation / test-net / loopback / link-local ranges, and private ranges already covered by local-ip"
regexTarget = "match"
regexes = [
  '''^(?:127\.|0\.|255\.)''',
  '''^169\.254\.''',
  '''^192\.0\.2\.''',
  '''^198\.51\.100\.''',
  '''^203\.0\.113\.''',
  '''^(?:10\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.)''',
]

# ---------------------------------------------------------------------------
# Shape rules. Quoted and assigned forms are separate rules; do not merge them.
# Every rule keeps a keyword list, and every keyword list stays accurate.
# ---------------------------------------------------------------------------

# Shape A: quoted or bare value — `"pool": "acme7"`, `pool: acme7`, `hostname: box-01`
[[rules]]
id = "identifier-quoted"
description = "Machine, host, pool or actor name used as a quoted or bare value"
regex = '''(?i)\b(?:pool|node|hostname|machine)\b["']?\s*:\s*["']?((?-i:[a-z0-9])[a-z0-9._-]+)\b'''
keywords = ["pool", "node", "actor", "hostname", "machine"]
tags = ["identifier"]

[[rules.allowlists]]
description = "module specifiers and node flags: node:fs, node:path, node --version"
regexTarget = "match"
regexes = [
  '''\bnode\s*(?::|--)\S*''',
]

[[rules.allowlists]]
description = "neutral placeholders the docs are meant to teach"
regexTarget = "match"
regexes = [
  '''(?i)\b(?:pool|node|hostname|machine)\b["']?\s*:\s*["']?(?:default|example|example\.com|local|local-test|test|tests?|workstation|prod|production|staging|dev|pool-a|pool-b|node-a|node-b|host-a|host-b|localhost)\b''',
]

# Shape B: `key=value` — `pool=box-mac2`, `node=box-lab7`, `pool=x&node=y`
[[rules]]
id = "identifier-assigned"
description = "Machine, host, pool or actor name assigned to a key"
# Two alternations: bare value or quoted value.
regex = '''(?i)\b(?:pool|node|actor|hostname|machine)=(?:([a-z0-9][a-z0-9._-]{2,})|"([^"]{3,})")'''
keywords = ["pool", "node", "actor", "hostname", "machine"]
tags = ["identifier"]

[[rules.allowlists]]
description = "exact neutral placeholders only"
regexTarget = "match"
regexes = [
  '''(?i)\b(?:pool|node|actor|hostname|machine)=(?:"?(?:default|example|local|local-test|test|tests|workstation|prod|production|staging|dev|pool-a|pool-b|node-a|node-b|host-a|host-b)"?)(?:[?&\s;,"']|$)''',
]

# Concrete hosts in endpoint values.
[[rules]]
id = "endpoint-host"
description = "Concrete host committed in an endpoint value"
regex = '''(?i)\bendpoint\b["']?\s*[:=]\s*["']?(?:https?://)?((?-i:[a-z0-9])[a-z0-9.-]{2,})'''
keywords = ["endpoint"]
tags = ["identifier"]

[[rules.allowlists]]
description = "placeholder and ip endpoint values"
# Prefix must mirror the rule exactly, `(?:https?://)?` included.
regexTarget = "match"
regexes = [
  '''(?i)\bendpoint\b["']?\s*[:=]\s*["']?(?:https?://)?(?:engine\.example\.com|example\.com|example\.org|localhost|127\.0\.0\.1)''',
  '''(?i)\bendpoint\b["']?\s*[:=]\s*["']?(?:https?://)?(?:\d{1,3}\.){3}\d{1,3}''',
]
# <!-- GENERATED RULES END -->

# ---------------------------------------------------------------------------
# Project-wide allowlist. Prefer a narrow regex, and prefer the rule-scoped
# [[rules.allowlists]] above. Whole-file entries: generated code, vendored trees,
# lockfiles only.
# ---------------------------------------------------------------------------

[allowlist]
description = "project-wide placeholders"
paths = [
  # Lockfiles.
  '''(?:^|/)(?:package-lock\.json|pnpm-lock\.yaml|yarn\.lock|Cargo\.lock|poetry\.lock|go\.sum)$''',
  # Vendored and generated trees.
  '''(?:^|/)(?:node_modules|vendor|third_party|plugged|\.venv|\.local)/''',
]
regexes = [
  # Documentation placeholders.
  '''(?i)\bEXAMPLE[_-]?(?:KEY|TOKEN|SECRET|PASSWORD)\b''',
  '''sk_(?:test|xxx)_[A-Za-z0-9]*''',
  # Hostnames under a reserved documentation domain, at any depth. Anchor on the TLD.
  '''(?i)https?://[^\s:@/"']*\.(?:example\.com|example\.org|example\.net)\b''',
  '''(?i)\b[a-z0-9.-]*\.(?:example\.com|example\.org|example\.net)\b''',
  '''(?i)\b(?:your|my|redacted|placeholder)[_-](?:token|key|secret|password)\b''',
]
